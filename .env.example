# SMTP configuration for magic-link authentication
# Copy this file to .env and fill in your values, then load with:
#   $env:SMTP_HOST="smtp.example.com"  (PowerShell)
#   export SMTP_HOST=smtp.example.com   (bash)

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password-or-app-password
SMTP_FROM=your-email@example.com   # optional — defaults to SMTP_USER

# Port for the local HTTP auth callback server (default: 8765)
AUTH_PORT=8765

# Gmail example: use an App Password (https://myaccount.google.com/apppasswords)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# Local dev with Mailhog (no real emails sent):
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=any
# SMTP_PASS=any
